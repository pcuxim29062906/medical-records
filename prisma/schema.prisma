// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  fullName     String
  email        String  @unique
  passwordHash String
  role         String  @default("ADMIN") // ADMIN, DOCTOR, ASSISTANT
  isActive     Boolean @default(true)

  sessions Session[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  consultations Consultation[]
  appointments  Appointment[]
}

model Patient {
  id              String   @id @default(cuid())
  fullName        String
  documentId      String   @unique // DNI, Cédula, Pasaporte
  birthDate       DateTime
  gender          String
  bloodType       String?
  allergies       String?  @db.Text
  chronicDiseases String?  @db.Text
  email           String?
  phone           String?

  // Relaciones
  consultations Consultation[]
  appointments  Appointment[]
  growthHistory GrowthHistory[] // Histórico de peso/altura
  createdAt     DateTime        @default(now())
}

model GrowthHistory {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  weight    Float? // en kg
  height    Float? // en cm
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Consultation {
  id   String   @id @default(cuid())
  date DateTime @default(now())

  // Signos vitales
  weight        Float?
  height        Float?
  temperature   Float?
  bloodPressure String? // Ej: "120/80"
  glucose       Float?

  // Clínica
  interrogation String  @db.Text // Lo que el paciente dice
  physicalExam  String? @db.Text // Hallazgos físicos
  diagnosis     String  @db.Text

  // Resultados de la consulta
  medicalPrescription String? @db.Text
  studyOrders         String? @db.Text

  // Doctor
  doctorId String // Médico que realiza la consulta
  doctor   User?   @relation(fields: [doctorId], references: [id])

  // Relaciones
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id])
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
}

model Appointment {
  id            String   @id @default(cuid())
  startDateTime DateTime
  endDateTime   DateTime
  reason        String?
  status        String   @default("PENDING") // PENDING, COMPLETED, CANCELLED

  // Doctor
  doctorId String // Médico que con el que se cita  
  doctor   User?   @relation(fields: [doctorId], references: [id])

  // Relaciones
  patientId    String
  patient      Patient       @relation(fields: [patientId], references: [id])
  consultation Consultation?
}

model Study {
  id          String  @id @default(cuid())
  name        String // Ej: "Radiografía de Tórax"
  category    String // Ej: "Imagenología", "Laboratorio"
  description String?
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
